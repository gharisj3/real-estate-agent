# Copy this file to .env and fill in the values. Never commit .env.
GROQ_API_KEY=
DJANGO_SECRET_KEY=
DEBUG=
# Random marker hidden inside the system prompt, used to catch the AI
# leaking its instructions. Any random string works — see STEPLOG.md for
# how it was generated. Changing it later is safe and recommended
# occasionally.
GUARD_CANARY_TOKEN=
# Set to false to take the assistant offline for every customer at once,
# with no code change — every chat gets "Our assistant is offline right
# now" instead. Leave as true (or leave this line out) for normal use.
PROPDESK_BOT_ENABLED=true
# Which instructions file the assistant uses: prompts/assistant_v1.md,
# prompts/assistant_v2.md, and so on. Change this to switch versions
# with no code change. Leave as v1 (or leave this line out) for now.
ASSISTANT_PROMPT_VERSION=v1
